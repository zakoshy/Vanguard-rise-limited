
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin by verifying
     * the existence of a document in the roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Publicly readable collections for website content
    // But only admins can create, update, or delete.
    
    match /project_management_success_stories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /investment_projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /real_estate_listings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /philanthropic_activities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_links/{docId} {
      // Allow get so customers can view their specific payment page
      allow get: if true;
      // Listing and writing is for admins only
      allow list, write: if isAdmin();
    }

    /**
     * Admin roles collection.
     * - Allow signed-in users to read *their own* admin role doc.
     * - Allow existing admins to manage roles.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
  }
}
